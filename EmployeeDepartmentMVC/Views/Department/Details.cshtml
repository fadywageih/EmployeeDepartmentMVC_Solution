@model DepartmentDetailsToReturnDto
@{
    ViewData["Title"] = "Department Details";
}

<!-- العنوان -->
<div class="mb-8">
    <h1 class="text-3xl font-extrabold text-gray-800">Department Details</h1>
    <p class="text-gray-600 mt-2">View comprehensive information about this department.</p>
</div>

<!-- تبويبات التنقل (Tabs) -->
<div class="border-b border-gray-300 mb-6">
    <nav class="flex space-x-8 rtl:space-x-reverse">
        <button type="button"
                class="py-3 px-1 border-b-2 border-blue-500 font-medium text-blue-600 focus:outline-none transition-colors duration-300"
                data-tab="general">
            General
        </button>
        <button type="button"
                class="py-3 px-1 border-b-2 border-transparent hover:border-gray-300 font-medium text-gray-500 hover:text-gray-700 focus:outline-none transition-colors duration-300"
                data-tab="administration">
            Administration
        </button>
    </nav>
</div>

<!-- محتوى التبويبات -->
<div class="bg-white rounded-lg shadow-md border border-gray-200">
    <!-- General Tab Content -->
    <div id="tab-general" class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.Code)
                </label>
                <input asp-for="Code"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.Name)
                </label>
                <input asp-for="Name"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.Description)
                </label>
                <input asp-for="Description"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.CreationDate)
                </label>
                <input asp-for="CreationDate"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
        </div>
    </div>

    <!-- Administration Tab Content -->
    <div id="tab-administration" class="p-6 hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.CreatedBy)
                </label>
                <input asp-for="CreatedBy"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.CreatedOn)
                </label>
                <input asp-for="CreatedOn"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.LastModificationBy)
                </label>
                <input asp-for="LastModificationBy"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    @Html.DisplayNameFor(model => model.LastModificationOn)
                </label>
                <input asp-for="LastModificationOn"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-900"
                       readonly />
            </div>
        </div>
    </div>
</div>

<!-- أزرار الإجراءات -->
<div class="mt-8 flex flex-col sm:flex-row gap-3">
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="inline-flex items-center justify-center px-5 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
        </svg>
        Edit
    </a>
    <a asp-action="Index"
       class="inline-flex items-center justify-center px-5 py-3 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Back to List
    </a>
</div>

<!-- سكربت JavaScript بسيط لإدارة التبويبات -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tabButtons = document.querySelectorAll('[data-tab]');
        const tabContents = document.querySelectorAll('[id^="tab-"]');

        tabButtons.forEach(button => {
            button.addEventListener('click', function() {
                const tabId = this.getAttribute('data-tab');

                // إزالة التحديد من جميع الأزرار
                tabButtons.forEach(btn => {
                    btn.classList.remove('border-blue-500', 'text-blue-600');
                    btn.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700');
                });

                // إخفاء جميع المحتويات
                tabContents.forEach(content => {
                    content.classList.add('hidden');
                });

                // تحديد الزر الحالي
                this.classList.remove('border-transparent', 'text-gray-500');
                this.classList.add('border-blue-500', 'text-blue-600');

                // عرض المحتوى المطلوب
                document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            });
        });
    });
</script>
@model IEnumerable<DepartmentToReturnDto>
@{
    ViewData["Title"] = "Departments";
    string viewBagMessage = ViewBag.Message;
}

<!-- رسالة من الـ Controller (إن وجدت) -->
@if (!string.IsNullOrEmpty(ViewData["Message"]?.ToString()))
{
    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-8 rounded-lg shadow-sm">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-blue-700 font-medium">
                    @ViewData["Message"]
                </p>
            </div>
        </div>
    </div>
}


<!-- العنوان وزر الإضافة -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <h1 class="text-3xl font-extrabold text-gray-800">Departments</h1>
    <a asp-controller="Department" asp-action="Create"
       class="inline-flex items-center px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        Create New Department
    </a>
</div>

<!-- جدول الأقسام -->
@if (Model.Any())
{
    <div class="bg-white shadow-xl rounded-xl overflow-hidden border border-gray-200">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gradient-to-r from-gray-800 to-gray-900">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-200 uppercase tracking-wider">
                            @Html.DisplayNameFor(D => D.Code)
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-200 uppercase tracking-wider">
                            @Html.DisplayNameFor(D => D.Name)
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-200 uppercase tracking-wider">
                            @Html.DisplayNameFor(D => D.CreationDate)
                        </th>
                        <th scope="col" class="px-6 py-4 text-center text-xs font-medium text-gray-200 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var d in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                @d.Code
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                @d.Name
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @d.CreationDate.ToShortDateString()
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                <!-- ✅ هنا نستخدم الـ Partial مرة واحدة فقط -->
                                <partial name="_ButtonsPartial" model="@d.Id" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- حالة عدم وجود أقسام -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-8 text-center mt-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-yellow-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.29-1.004-5.824-2.537L8.34 10.34m8.485 8.486L14.66 16.66m0 0l-2.828-2.828m2.828 2.828l2.829-2.829" />
        </svg>
        <h3 class="text-xl font-bold text-yellow-800 mb-2">No Departments Found</h3>
        <p class="text-yellow-700 mb-4">It looks like there are no departments in the system yet.</p>
        <a asp-controller="Department" asp-action="Create"
           class="inline-block px-6 py-2 bg-yellow-600 hover:bg-yellow-700 text-white font-semibold rounded-lg shadow transition-colors duration-300">
            Create Your First Department
        </a>
    </div>
}
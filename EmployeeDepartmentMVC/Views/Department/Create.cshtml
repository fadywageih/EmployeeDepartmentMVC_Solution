@model CreatedDepartmentDto
@{
    ViewData["Title"] = "Create Department";
}

<!-- العنوان -->
<div class="mb-8">
    <h1 class="text-3xl font-extrabold text-gray-800">Create New Department</h1>
    <p class="text-gray-600 mt-2">Fill in the details below to create a new department.</p>
</div>

<!-- النموذج -->
<form action="/Department/Create" method="post" class="bg-white shadow-xl rounded-xl p-6 sm:p-8 border border-gray-200">

    <!-- ملخص الأخطاء -->
    <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
        <div class="flex">
            <svg class="h-5 w-5 text-red-400 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium">Please correct the errors below.</span>
        </div>
    </div>

    <!-- حقل الكود -->
    <div class="mb-6">
        <label asp-for="Code" class="block text-sm font-semibold text-gray-700 mb-2">
            @Html.DisplayNameFor(model => model.Code)
        </label>
        <input asp-for="Code"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200"
               placeholder="e.g. HR, IT, FIN" />
        <span asp-validation-for="Code" class="mt-2 text-sm text-red-600 font-medium"></span>
    </div>

    <!-- حقل الاسم -->
    <div class="mb-6">
        <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">
            @Html.DisplayNameFor(model => model.Name)
        </label>
        <input asp-for="Name"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200"
               placeholder="Enter department name" />
        <span asp-validation-for="Name" class="mt-2 text-sm text-red-600 font-medium"></span>
    </div>

    <!-- حقل الوصف -->
    <div class="mb-6">
        <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">
            @Html.DisplayNameFor(model => model.Description)
        </label>
        <textarea asp-for="Description"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200 resize-y min-h-[100px]"
                  placeholder="Describe the department's purpose..."></textarea>
    </div>

    <!-- حقل تاريخ الإنشاء -->
    <div class="mb-8">
        <label asp-for="CreationDate" class="block text-sm font-semibold text-gray-700 mb-2">
            @Html.DisplayNameFor(model => model.CreationDate)
        </label>
        <input type="date"
               asp-for="CreationDate"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200" />
        <span asp-validation-for="CreationDate" class="mt-2 text-sm text-red-600 font-medium"></span>
    </div>

    <!-- أزرار الإرسال والعودة -->
    <div class="flex flex-col sm:flex-row gap-3">
        <button type="submit"
                class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Create Department
        </button>
        <a asp-controller="Department" asp-action="Index"
           class="flex-1 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300 text-center flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to List
        </a>
    </div>

</form>

@section validationScripts {
    <partial name="_ValidationScriptsPartial" />
}
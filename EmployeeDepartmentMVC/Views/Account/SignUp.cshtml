@model SignUpViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<form asp-action="SignUp" method="post" class="space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

    <!-- First Name -->
    <div>
        <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
        <input asp-for="FirstName" placeholder="Enter First Name"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- Last Name -->
    <div>
        <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
        <input asp-for="LastName" placeholder="Enter Last Name"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- User Name (Full Name) -->
    <div>
        <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <input asp-for="UserName" placeholder="Enter username"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- Email -->
    <div>
        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
        <input asp-for="Email" placeholder="Enter email address"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- Password -->
    <div>
        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input asp-for="Password" type="password" placeholder="Enter Password"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- Confirm Password -->
    <div>
        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- Agree to Terms -->
    <div class="flex items-start">
        <input asp-for="IsAgree" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded mt-1" required />
        <label asp-for="IsAgree" class="ml-2 block text-sm text-gray-700">
            I agree to the <a href="#" class="text-primary hover:underline">terms of service</a>
        </label>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="w-full py-3 px-4 bg-primary hover:bg-primary-hover text-white font-medium rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
        Sign Up
    </button>

    <!-- Sign In Link -->
    <div class="text-center text-sm text-gray-600">
        Already have an account?
        <a asp-action="SignIn" class="text-primary font-medium hover:underline">Sign In</a>
    </div>
</form>

@section validationScripts {
    <partial name="_ValidationScriptsPartial" />
}
@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div asp-validation-summary="All" class="text-red-600 text-sm p-3 bg-white-50 rounded-lg "></div>

<form asp-action="SendResetPassword" method="post" class="space-y-5">

    <!-- Email Field -->
    <div>
        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
        <input asp-for="Email" placeholder="Enter email address"
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="w-full py-3 px-4 bg-primary hover:bg-primary-hover text-white font-medium rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
        Send Reset Link
    </button>
</form>

@section validationScripts {
    <partial name="_ValidationScriptsPartial" />
}
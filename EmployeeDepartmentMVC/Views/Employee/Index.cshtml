@model IEnumerable<EmployeeDto>
@{
    ViewData["Title"] = "Employees";
    Layout = "_Layout"; // أو غيره حسب نظامك
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-6 gap-4">
        <h1 class="text-2xl font-bold text-indigo-600">All Employees</h1>
        <a asp-controller="Employee" asp-action="Create"
           class="inline-flex items-center px-4 py-2 bg-white border border-indigo-600 text-indigo-600 rounded-lg hover:bg-indigo-50 transition font-medium">
            <span>+ Create New Employee</span>
        </a>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-xl shadow-sm p-5 mb-6">
        <form asp-action="Index" method="get" class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1">
                <label for="searchInp" class="sr-only">Search by name</label>
                <input type="text" name="search" id="searchInp"
                       placeholder="Search By Name..."
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
            </div>
            <div class="sm:w-auto">
                <button type="submit"
                        class="w-full sm:w-auto px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow transition">
                    Search
                </button>
            </div>
        </form>
    </div>

    <!-- Employees Table -->
    @if (Model.Any())
    {
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dept.</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Salary</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Active</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gender</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var employee in Model)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">@employee.Name</td>
                                <td class="px-6 py-4 whitespace-nowrap">@employee.Email</td>
                                <td class="px-6 py-4 whitespace-nowrap">@employee.Department</td>
                                <td class="px-6 py-4 whitespace-nowrap">@employee.EmployeeType</td>
                                <td class="px-6 py-4 whitespace-nowrap">@employee.Age</td>
                                <td class="px-6 py-4 whitespace-nowrap">@employee.Salary</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @(employee.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                        @(employee.IsActive ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">@employee.Gender</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                                    <partial name="_ButtonsPartial" model="@employee.Id" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-6 text-center mt-6">
            <h3 class="text-lg font-medium">Sorry, there are no employees 😢</h3>
        </div>
    }
</div>
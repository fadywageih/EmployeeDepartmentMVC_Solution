@model EmployeeDetailsDto

<div class="max-w-4xl mx-auto px-4 py-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Employee Details</h1>

    <!-- Employee Image -->
    <div class="flex justify-center mb-6">
        <img src="~/Files/Images/@(string.IsNullOrEmpty(Model.Image) ? "default.png" : Model.Image)"
             alt="Employee Image"
             class="w-32 h-32 rounded-full object-cover border-2 border-gray-200 shadow-sm" />
    </div>

    <!-- Tabs -->
    <div class="border-b border-gray-200 mb-6">
        <nav class="flex space-x-6" role="tablist">
            <button type="button"
                    class="px-4 py-2 font-medium text-gray-500 hover:text-indigo-600 border-b-2 border-transparent"
                    data-tab="general"
                    onclick="showTab('general')">
                General
            </button>
            <button type="button"
                    class="px-4 py-2 font-medium text-gray-500 hover:text-indigo-600 border-b-2 border-transparent"
                    data-tab="administration"
                    onclick="showTab('administration')">
                Administration
            </button>
        </nav>
    </div>

    <!-- Tab Content -->
    <div id="general" class="tab-content space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div><label class="block text-sm font-medium text-gray-700">Name</label><p class="mt-1 text-gray-900">@Model.Name</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Email</label><p class="mt-1 text-gray-900">@Model.Email</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Address</label><p class="mt-1 text-gray-900">@Model.Address</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Age</label><p class="mt-1 text-gray-900">@Model.Age</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Salary</label><p class="mt-1 text-gray-900">@Model.Salary.ToString("C")</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Phone Number</label><p class="mt-1 text-gray-900">@Model.PhoneNumber</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Employee Type</label><p class="mt-1 text-gray-900">@Model.EmployeeType</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Hiring Date</label><p class="mt-1 text-gray-900">@Model.HiringDate.ToString("yyyy-MM-dd")</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Gender</label><p class="mt-1 text-gray-900">@Model.Gender</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Is Active</label><p class="mt-1 text-gray-900">@(Model.IsActive ? "Yes" : "No")</p></div>
        </div>
    </div>

    <div id="administration" class="tab-content hidden space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div><label class="block text-sm font-medium text-gray-700">Created By</label><p class="mt-1 text-gray-900">@Model.CreatedBy</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Created On</label><p class="mt-1 text-gray-900">@Model.CreatedOn.ToString("yyyy-MM-dd HH:mm")</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Last Modified By</label><p class="mt-1 text-gray-900">@Model.LastModifiedBy</p></div>
            <div><label class="block text-sm font-medium text-gray-700">Last Modified On</label><p class="mt-1 text-gray-900">@Model.LastModifiedOn.ToString("yyyy-MM-dd HH:mm")</p></div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-8 flex gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow transition">
            Edit
        </a>
        <a asp-action="Index"
           class="px-5 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">
            Back To List
        </a>
    </div>
</div>

<!-- Simple Tab Switching Script -->
<script>
    function showTab(tabName) {
        // Hide all tab contents
        document.querySelectorAll('.tab-content').forEach(el => {
            el.classList.add('hidden');
        });
        // Show selected tab
        document.getElementById(tabName).classList.remove('hidden');

        // Update active tab style (optional)
        document.querySelectorAll('[data-tab]').forEach(btn => {
            btn.classList.remove('text-indigo-600', 'border-indigo-600');
            btn.classList.add('text-gray-500', 'border-transparent');
        });
        document.querySelector(`[data-tab="${tabName}"]`).classList.remove('text-gray-500', 'border-transparent');
        document.querySelector(`[data-tab="${tabName}"]`).classList.add('text-indigo-600', 'border-indigo-600');
    }

    // Show General tab by default
    document.addEventListener('DOMContentLoaded', () => {
        showTab('general');
    });
</script>
@model UpdatedEmployeeDto
@{
    ViewData["Title"] = "Edit Employee";
    Layout = "_Layout";
    var departments = (ViewData["Departments"] as IEnumerable<DepartmentToReturnDto>)?.Select(d => new SelectListItem
            {
                Value = d.Id.ToString(),
                Text = d.Code
            }).ToList() ?? new List<SelectListItem>();
}

<div class="max-w-3xl mx-auto p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Edit Employee</h1>

    <form asp-action="Edit" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm p-3 bg-red-50 rounded-lg border border-red-200"></div>

        <!-- Row: Name & Email -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                <input asp-for="Name" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
                <span asp-validation-for="Name" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input asp-for="Email" type="email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <!-- Row: Address & Age -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="Address" class="block text-sm font-medium text-gray-700 mb-1">Address</label>
                <input asp-for="Address" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
                <span asp-validation-for="Address" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Age" class="block text-sm font-medium text-gray-700 mb-1">Age</label>
                <input asp-for="Age" type="number" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
                <span asp-validation-for="Age" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <!-- Row: Salary & Phone -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="Salary" class="block text-sm font-medium text-gray-700 mb-1">Salary</label>
                <input asp-for="Salary" type="number" step="0.01" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
                <span asp-validation-for="Salary" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                <input asp-for="PhoneNumber" type="tel" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
                <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <!-- Employee Type -->
        <div>
            <label asp-for="EmployeeType" class="block text-sm font-medium text-gray-700 mb-1">Employee Type</label>
            <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition">
                <option value="">Choose...</option>
            </select>
            <span asp-validation-for="EmployeeType" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <!-- Gender (Radio Buttons) -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Gender</label>
            <div class="flex flex-wrap gap-4">
                @foreach (Gender genderOption in Enum.GetValues(typeof(Gender)))
                {
                    <label class="inline-flex items-center">
                        <input type="radio" asp-for="Gender" value="@genderOption" class="h-4 w-4 text-primary focus:ring-primary" />
                        <span class="ml-2 text-gray-700">@genderOption</span>
                    </label>
                }
            </div>
            <span asp-validation-for="Gender" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <!-- Hiring Date -->
        <div>
            <label asp-for="HiringDate" class="block text-sm font-medium text-gray-700 mb-1">Hiring Date</label>
            <input asp-for="HiringDate" type="date" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" />
            <span asp-validation-for="HiringDate" class="text-red-500 text-xs mt-1 block"></span>
        </div>
        <div>
            <label asp-for="DepartmentId" class="block text-sm font-medium text-gray-700 mb-1">Department</label>
            <select asp-for="DepartmentId" asp-items="departments" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition">
                <option value="">Choose...</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-red-500 text-xs mt-1 block"></span>
        </div>
        <!-- IsActive Checkbox -->
        <div class="flex items-center">
            <input asp-for="IsActive" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary rounded" />
            <label asp-for="IsActive" class="ml-2 block text-sm text-gray-700">Active Employee</label>
        </div>

        <!-- Submit & Cancel Buttons -->
        <div class="flex flex-wrap gap-3 pt-4">
            <button type="submit" class="px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                Save
            </button>
            <a asp-controller="Employee" asp-action="Index" class="px-6 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">
                Cancel
            </a>
        </div>

    </form>
</div>

@section validationScripts {
    <partial name="_ValidationScriptsPartial" />
}
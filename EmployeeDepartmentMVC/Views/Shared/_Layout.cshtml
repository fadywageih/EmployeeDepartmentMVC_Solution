<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeDepartmentMVC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeDepartmentMVC.styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <header>
        <nav class="bg-white border-b border-gray-200 shadow-sm py-3">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between">
                    <a class="text-xl font-semibold text-gray-800 hover:text-blue-600 transition-colors"
                       asp-area="" asp-controller="Home" asp-action="Index">
                        EmployeeDepartmentMVC
                    </a>
                    <button id="mobile-menu-button" class="md:hidden p-2 rounded-md text-gray-500 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500">
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <!-- قائمة التنقل - مخفية على الجوال، ظاهرة على الشاشات المتوسطة فأكبر -->
                    <div id="mobile-menu" class="hidden md:flex md:items-center md:space-x-6">
                        <a class="px-3 py-2 text-gray-700 hover:text-blue-600 hover:bg-gray-100 rounded-md transition-colors"
                           asp-area="" asp-controller="Employee" asp-action="Index">Employees</a>
                        <a class="px-3 py-2 text-gray-700 hover:text-blue-600 hover:bg-gray-100 rounded-md transition-colors"
                           asp-area="" asp-controller="Department" asp-action="Index">Departments</a>
                        <a class="px-3 py-2 text-gray-700 hover:text-blue-600 hover:bg-gray-100 rounded-md transition-colors"
                           asp-area="" asp-controller="Account" asp-action="SignOut">Sign Out</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- استبدال container بـ container من Tailwind -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-gray-200 bg-white mt-8">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 text-center text-gray-500 text-sm">
            &copy; 2025 - EmployeeDepartmentMVC -  Privacy
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const button = document.getElementById('mobile-menu-button');
            const menu = document.getElementById('mobile-menu');

            button.addEventListener('click', function() {
                menu.classList.toggle('hidden');
            });
        });
    </script>

    @await RenderSectionAsync("validationScripts", required: false)
</body>
</html>